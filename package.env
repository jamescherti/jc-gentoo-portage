# ----------------------------------------------------------------------------
# Optimize: Rust
# ----------------------------------------------------------------------------
sys-apps/ripgrep rust-lto-fat.conf
sys-apps/fd rust-lto-fat.conf
app-shells/fzf rust-lto-fat.conf
dev-util/ruff rust-lto-fat.conf
dev-util/difftastic rust-lto-fat.conf
sys-apps/uutils-coreutils rust-lto-fat.conf
sys-apps/uutils-findutils rust-lto-fat.conf

# TODO: Enable fat LTO for librsvg and glycin-loaders to inline XML parsing,
# vector math, and sandboxed image decoding routines across crates.

# ----------------------------------------------------------------------------
# Optimize with -O3 and lto
# ----------------------------------------------------------------------------
# Optimizes the ANSI escape sequence state machine and screen redraw loops.
# LTO and -fno-plt reduce call overhead during high-throughput terminal output.
app-misc/tmux O3-lto.conf
app-misc/tmux no-plt.conf

# Linear algebra, multi-dimensional array operations, and Fourier transforms.
# -O3 and LTO enable loop unrolling, auto-vectorization, and cross-file inlining.
sci-libs/fftw O3-lto.conf  # medium LTO value

sci-libs/openblas O3-lto.conf  # medium LTO value

sci-libs/lapack O3-lto.conf  # medium LTO value

sci-libs/gsl O3-lto.conf  # medium LTO value

# Low-latency multimedia routing and real-time audio graph processing.
# -O3 vectorizes DSP math while LTO inlines functions across graph nodes.
media-video/pipewire O3-lto.conf

# Pixel buffer manipulation, color space conversions, and convolution filters.
# -O3 vectorizes pixel loops and LTO reduces cross-module call overhead.
# app-office/libreoffice   lto.conf
media-gfx/gimp O3-lto.conf

# Desktop search indexers that extract file metadata and execute SQLite queries.
# LTO inlines cross-module parsing and database calls, reducing CPU overhead.
app-misc/localsearch lto.conf

app-misc/tinysparql lto.conf

# GTK4/GObject terminal frontend. -O3 and LTO inline small signal handlers,
# remove dead GObject boilerplate, and reduce UI event dispatch latency.
gui-apps/gnome-console O3-lto.conf

x11-terms/gnome-terminal O3-lto.conf

# Terminal emulator widget handling ANSI parsing, scrollback, and glyph drawing.
# -O3 and LTO optimize state machine branches and inline buffer management calls.
gui-libs/vte O3-lto.conf

# GTK4 building blocks and layout widgets. -O3 and LTO inline layout math and
# gesture callbacks while stripping unused GObject type-checking overhead.
gui-libs/libadwaita O3-lto.conf

# Core DSP, audio resampling, and format conversion routines for GStreamer.
# -O3 vectorizes sample processing loops and LTO inlines pipeline dispatch calls.
media-libs/gst-plugins-base O3-lto.conf

# LTO inlines cross-module GObject and GTK4 calls in the file manager UI.
gnome-base/nautilus lto.conf

# Regular expression compilation and state machine execution engines.
# -O3 and LTO optimize NFA/DFA state transitions and inline matching helpers.
dev-libs/libpcre O3-lto.conf
dev-libs/libpcre2 O3-lto.conf

# Font rasterization, glyph shaping, text layout, and 2D vector rendering.
# -O3 and LTO vectorize bitmap math and inline cross-file rendering calls.
media-libs/harfbuzz O3-lto.conf
media-libs/freetype O3-lto.conf
x11-libs/cairo O3-lto.conf
x11-libs/pango O3-lto.conf

# Object hashing, zlib compression, and binary delta calculation.
# -O3 and LTO unroll bitwise loops and inline packfile traversal routines.
dev-vcs/git O3-lto.conf

# Media player pipeline handling demuxing, color scaling, and subtitle rendering.
# -O3 optimizes software fallback filters and LTO inlines module dispatch calls.
media-video/mpv O3-lto.conf

# PDF parsing, vector path rendering, and font rasterization engines.
# -O3 optimizes floating-point raster loops and LTO devirtualizes C++ calls.
app-text/poppler O3-lto.conf
app-text/mupdf O3-lto.conf

# Low-level pixel manipulation, matrix transforms, and alpha compositing.
# -O3 enables SIMD vectorization and LTO inlines modular fast-path routines.
x11-libs/pixman O3-lto.conf

# XML and XSLT parsing, DOM tree traversal, and XPath evaluation.
# -O3 optimizes string scanning and LTO inlines node traversal across internal APIs.
dev-libs/libxslt O3-lto.conf
dev-libs/libxml2 O3-lto.conf

# PostScript and PDF interpreter that rasterizes vector paths into bitmaps.
# -O3 unrolls and vectorizes floating-point coordinate and shading loops.
app-text/ghostscript-gpl O3.conf

# Graph-based image processing, pixel format conversion, and RAW demosaicing.
# -O3 vectorizes pixel buffer loops and LTO inlines operations across graph nodes.
media-libs/gegl O3-lto.conf
media-libs/babl O3-lto.conf
media-libs/libraw O3-lto.conf

# Lossless data compression and archive utilities using LZ77, Huffman, and BWT.
# -O3 and LTO unroll bitstream loops and inline dictionary lookup functions.
sys-libs/zlib O3-lto.conf

app-arch/gzip O3-lto.conf

app-arch/zstd O3-lto.conf

app-arch/lz4 O3-lto.conf

app-arch/7zip O3-lto.conf

app-arch/lzip O3-lto.conf

app-arch/brotli O3-lto.conf

app-arch/unzip O3-lto.conf

app-arch/zip O3-lto.conf

app-arch/bzip2 O3-lto.conf

app-arch/xz-utils O3-lto.conf

# Audio and video codecs performing DCT, wavelet transforms, and motion estimation.
# -O3 vectorizes frame processing loops and LTO inlines hot functions across files.
media-video/ffmpeg O3-lto.conf
media-libs/x264 O3-lto.conf
media-libs/x265 O3-lto.conf
media-libs/dav1d O3-lto.conf
media-libs/libvpx O3-lto.conf
media-libs/libaom O3-lto.conf
media-libs/svt-av1 O3-lto.conf

media-libs/flac O3-lto.conf
media-libs/opus O3-lto.conf
media-libs/opusfile O3-lto.conf
media-libs/libvorbis O3-lto.conf
media-libs/libsamplerate O3-lto.conf
media-libs/libogg O3-lto.conf
media-libs/libsndfile O3-lto.conf
media-libs/soxr O3-lto.conf

# Image encoding, decoding, color management, and SVG rasterization libraries.
# -O3 and LTO vectorize pixel transforms and inline cross-module codec routines.
media-libs/libjxl O3-lto.conf
media-libs/libavif O3-lto.conf
media-libs/openjpeg O3-lto.conf
media-libs/libwebp O3-lto.conf
media-libs/libjpeg-turbo O3-lto.conf
media-libs/libpng O3-lto.conf
media-libs/giflib O3-lto.conf
media-gfx/imagemagick O3-lto.conf
gnome-base/librsvg O3-lto.conf
media-libs/tiff O3-lto.conf
media-gfx/exiv2 O3-lto.conf
media-libs/lcms O3-lto.conf

# Incremental parsing library that builds and updates concrete syntax trees.
# -O3 and LTO optimize state machine transitions and inline AST node traversal.
dev-libs/tree-sitter O3-lto.conf

# Embedded relational database engine. -O3 and LTO inline B-tree cursor
# navigation and optimize switch dispatch in the VDBE bytecode interpreter.
dev-db/sqlite O3-lto.conf

# LTO and -fno-semantic-interposition inline C core evaluation, garbage
# collection, and buffer display routines across compilation units.
app-editors/emacs lto.conf
app-editors/emacs semantic-interposition.conf

# Real-time audio DSP plugins for convolution, filtering, and RNN noise reduction.
# -O3 vectorizes FFT and matrix math while LTO inlines frame processing calls.
media-libs/rnnoise O3-lto.conf
media-libs/zita-convolver O3-lto.conf
media-libs/lsp-plugins O3-lto.conf
media-plugins/calf O3-lto.conf

# ----------------------------------------------------------------------------
# Command line
# ----------------------------------------------------------------------------
sys-apps/findutils O3.conf

sys-apps/sed O3-lto.conf

sys-apps/gawk O3-lto.conf

sys-apps/grep O3-lto.conf

sys-apps/mawk O3-lto.conf

# TODO remove?
sys-apps/coreutils O3-lto.conf

# TODO remove?
sys-libs/ncurses O3.conf

# Use flag "pgo"
app-shells/bash O3-lto.conf

# ----------------------------------------------------------------------------
# Optimize with -O3
#
# NOTE: Define this before all others
# ----------------------------------------------------------------------------
# Real-time audio effects host for PipeWire streams.
# -O3 vectorizes audio buffer processing and filter orchestration loops.
media-sound/easyeffects O3.conf

# Unicode normalization, case-folding, and UTF-8 grapheme cluster parsing.
# -O3 unrolls character array lookup loops and speeds up state table transitions.
dev-libs/libutf8proc O3.conf

# Arbitrary-precision arithmetic library. While hot loops use hand-written
# assembly, -O3 optimizes the surrounding C orchestration and fallback routines.
dev-libs/gmp O3.conf

# Stream-oriented XML parser (expat) and source code syntax highlighter.
# -O3 inlines state machine callbacks and unrolls token scanning loops.
dev-libs/expat O3.conf
# dev-libs/expat lto.conf  # Moderate candidates
app-text/highlight O3.conf

# Optical character recognition engine using LSTM neural networks.
# -O3 vectorizes matrix multiplication and image thresholding loops.
app-text/tesseract O3.conf

# Command-line JSON processor with a bytecode-based filtering engine.
# -O3 optimizeslexer token scanning and AST traversal loops.
app-misc/jq O3.conf

# Terminal emulator library written in C. -O3 optimizes the ANSI escape
# parser state machine and vectorizes screen cell buffer memory shifts.
dev-libs/libvterm O3.conf

# File comparison utilities computing Myers diff and byte-by-byte equality.
# -O3 vectorizes memory buffer scanning and unrolls line-matching loops.
sys-apps/diffutils O3.conf

# File integrity checker that computes cryptographic hashes over filesystem trees.
# -O3 unrolls bitwise round functions in SHA-256 and SHA-512 digest loops.
app-forensics/aide O3.conf

# Video thumbnailer that decodes keyframes and scales them to bitmaps via FFmpeg.
# -O3 optimizes pixel format conversion and image downscaling loops.
media-video/ffmpegthumbnailer O3.conf

# Image viewer and browser performing on-the-fly decoding, color profiling, and
# Lanczos/bicubic scaling. -O3 vectorizes pixel interpolation loops.
media-gfx/gthumb O3.conf

# Desktop full-text search tool based on Xapian. -O3 speeds up document text
# tokenization, stemming, and inverted index compression.
# TODO
app-misc/recoll O3.conf

# Cryptographic and non-cryptographic hash functions. -O3 unrolls bitwise
# permutation rounds and vectorizes memory block processing.
dev-libs/xxhash O3.conf
app-crypt/libb2 O3.conf
app-crypt/argon2 O3.conf
app-crypt/mhash O3.conf
app-crypt/rhash O3.conf

# SIMD-accelerated Unicode validation and transcoding library.
# -O3 inlines dispatch wrappers around hand-tuned SIMD intrinsics.
dev-cpp/simdutf O3.conf

# Bitmap-to-vector tracing utility. -O3 optimizes polygon pathfinding and
# floating-point Bezier curve fitting loops.
media-gfx/potrace O3.conf

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
# GLib 2.68+ made g_utf8_next_char return const char*, breaking assignment to
# mutable gchar* in sdcv-0.5.5. -fpermissive downgrades this error to a warning.
app-text/sdcv permissive.conf

# Legacy C89 codebase with implicit function declarations and incompatible
# pointer types that fail under GCC 14+ defaults.
net-proxy/tsocks legacy-c.conf

# ----------------------------------------------------------------------------
# jemalloc
# ----------------------------------------------------------------------------

# Clang and LLD perform millions of small heap allocations for AST nodes and
# symbol tables. jemalloc reduces heap fragmentation and lock contention.
llvm-core/clang jemalloc.conf
llvm-core/llvm jemalloc.conf

# Caching proxy daemon that allocates millions of small in-memory objects.
# jemalloc prevents long-term heap fragmentation and stabilizes resident memory.
net-proxy/squid jemalloc.conf

# ----------------------------------------------------------------------------
# Link-Time Optimization (LTO) Assignments
# ----------------------------------------------------------------------------
# C++ caching proxy daemon. LTO devirtualizes class methods and inlines HTTP
# header parsing and ACL ruleset evaluation across translation units.
net-proxy/squid          lto.conf

# Avoid forcing LTO on binutils via package.env; bypassing ebuild flag filtering
# on the system linker (ld) and assembler (as) risks subtle toolchain breakage.
# sys-devel/binutils       lto.conf

# LTO and -fno-semantic-interposition allow GCC/Clang to inline C API calls
# into the CPython bytecode evaluation loop, bypassing PLT indirection.
dev-lang/python          lto.conf
dev-lang/python          semantic-interposition.conf

# LTO inlines internal C functions across buffer manipulation, syntax
# highlighting, and Vimscript evaluation modules.
app-editors/vim          lto.conf

# Lightweight scripting interpreter. LTO inlines VM opcode handlers and
# garbage collector routines across compilation units.
dev-lang/lua            lto.conf

# Very high compile time and RAM cost, but LTO devirtualizes AST passes and
# inlines IR manipulation across the compiler toolchain.
# sys-devel/gcc           lto.conf
# TODO Disable llvm and clang?
llvm-core/llvm          lto.conf
llvm-core/clang         lto.conf

# Session manager and core framework for media pipelines. LTO reduces
# cross-module function call overhead during graph routing and event dispatch.
media-video/wireplumber  lto.conf
media-libs/gstreamer     lto.conf

# GTK4 document viewer. LTO inlines GObject UI callbacks and reduces wrapper
# overhead around Poppler and Cairo rendering calls.
app-text/papers lto.conf

# JavaScript bindings for GNOME based on SpiderMonkey and GObject Introspection.
# LTO inlines FFI marshaling paths between JS and C libraries.
dev-libs/gjs lto.conf

# Cryptography & Core System Libraries
# Minor but frequent system-wide responsiveness gains.

# Digital audio editor. LTO inlines internal track mixing, waveform rendering,
# and effects pipeline dispatch across C++ modules.
media-sound/audacity lto.conf

# Lightweight DNS forwarder and DHCP server. LTO inlines packet parsing and
# cache lookup functions across source files.
# net-dns/dnsmasq lto.conf

# Vala/GTK4 disk usage analyzer. LTO flattens generated C/GObject boilerplate
# and inlines UI tree-view rendering callbacks.
sys-apps/baobab lto.conf

dev-db/lmdb lto.conf  # medium LTO value
